Menu="Buttons"
Title="SMB Restart"
Icon="smb-restart.png"
Code="f021"
---
<?PHP
/* Renders as a real nav-item button in the topbar's right-hand button row
 * (same mechanism Unraid itself uses for the power button), via find_pages('Buttons')
 * in webGui/include/PageBuilder.php. No core-file patching involved. */
$unraid = parse_ini_file('/etc/unraid-version');
$attr   = version_compare($unraid['version'], '6.11.9', '>') ? '.' : '#';
?>
<script>
$(function() {
  var $btn = $('<?=$attr?>nav-item.SmbRestart a');
  $btn.prop('onclick', null).attr('id', 'nav-smb-restart');
  var lastRunning = null;

  function paint(running) {
    lastRunning = running;
    $btn.attr('title', running ? 'SMB is running — click to restart' : 'SMB is stopped — click to start');
    // Two rendering modes depending on viewport width: an <img> (narrow) or a
    // CSS ::before font-icon using the page's Code attribute (wide, >=1330px).
    // Cover both: dim the image, and recolor the element (::before inherits it).
    $btn.find('img').css('opacity', running ? 1 : 0.4);
    $btn.css('color', running ? '' : '#e05d44');
  }

  function poll() {
    $.getJSON('/plugins/smb-restart/include/exec.php', {action: 'status'}, function(data) {
      paint(data.running);
    });
  }

  function doAction() {
    $btn.find('img').css('opacity', 0.7);
    $.getJSON('/plugins/smb-restart/include/exec.php', {action: 'restart'}, function(data) {
      paint(data.running);
    });
  }

  $btn.on('click', function(e) {
    e.preventDefault();
    function confirmAndRun(running) {
      swal({
        title: running ? 'Restart SMB?' : 'Start SMB?',
        text: running
          ? 'This will restart the SMB server, briefly disconnecting any active SMB connections.'
          : 'SMB is currently stopped. Start it now?',
        type: 'warning',
        showCancelButton: true,
        confirmButtonText: running ? 'Restart' : 'Start',
        cancelButtonText: 'Cancel'
      }, function(isConfirm) {
        if (isConfirm) doAction();
      });
    }
    if (lastRunning === null) {
      $.getJSON('/plugins/smb-restart/include/exec.php', {action: 'status'}, function(data) {
        paint(data.running);
        confirmAndRun(data.running);
      });
    } else {
      confirmAndRun(lastRunning);
    }
  });

  poll();
  setInterval(poll, 15000);
});
</script>
