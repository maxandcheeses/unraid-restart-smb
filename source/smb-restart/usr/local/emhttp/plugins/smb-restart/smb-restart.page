Menu="Utilities"
Title="SMB Restart"
Icon="icon-share"
---
<?php
$running = false;
exec('pidof smbd', $o, $ret);
$running = ($ret === 0);

$cfg = @parse_ini_file('/boot/config/plugins/smb-restart/smb-restart.cfg');
$showNav = ($cfg['SHOW_NAV_ICON'] ?? 'true') !== 'false';
?>
<style>
#smb-restart-status { font-size: 1.1em; margin-bottom: 1em; }
#smb-restart-status .dot { display:inline-block; width:10px; height:10px; border-radius:50%; margin-right:6px; }
#smb-restart-status .dot.up { background:#3c3; }
#smb-restart-status .dot.down { background:#c33; }
#smb-restart-settings { margin: 1.5em 0; padding-top: 1em; border-top: 1px solid rgba(128,128,128,0.3); }
</style>

<div id="smb-restart-status">
  <span class="dot <?= $running ? 'up' : 'down' ?>"></span>
  SMB server is currently <b><?= $running ? 'running' : 'stopped' ?></b>
</div>

<button class="btn" id="smb-restart-btn">Restart / Start SMB</button>
<div id="smb-restart-result" style="margin-top:1em;white-space:pre-wrap;"></div>

<div id="smb-restart-settings">
  <label>
    <input type="checkbox" id="smb-restart-shownav" <?= $showNav ? 'checked' : '' ?>>
    Show icon in topbar
  </label>
  <div id="smb-restart-settings-note" style="margin-top:0.5em;color:#888;"></div>
</div>

<script>
function doSmbAction() {
  var $btn = $('#smb-restart-btn').prop('disabled', true).text('Working...');
  $.getJSON('/plugins/smb-restart/include/exec.php', {action:'restart'}, function(data){
    $('#smb-restart-result').text(data.action + ' — running: ' + data.running + (data.output ? ('\n' + data.output) : ''));
    $('#smb-restart-status .dot').attr('class', 'dot ' + (data.running ? 'up' : 'down'));
    $('#smb-restart-status b').text(data.running ? 'running' : 'stopped');
  }).always(function(){
    $btn.prop('disabled', false).text('Restart / Start SMB');
  });
}

$('#smb-restart-btn').on('click', function(){
  $.getJSON('/plugins/smb-restart/include/exec.php', {action:'status'}, function(data){
    var running = data.running;
    swal({
      title: running ? 'Restart SMB?' : 'Start SMB?',
      text: running
        ? 'This will restart the SMB server, briefly disconnecting any active SMB connections.'
        : 'SMB is currently stopped. Start it now?',
      type: 'warning',
      showCancelButton: true,
      confirmButtonText: running ? 'Restart' : 'Start',
      cancelButtonText: 'Cancel'
    }, function(isConfirm){
      if (isConfirm) doSmbAction();
    });
  });
});

$('#smb-restart-shownav').on('change', function(){
  var show = $(this).is(':checked');
  $.getJSON('/plugins/smb-restart/include/exec.php', {action:'save-settings', showNav: show}, function(){
    $('#smb-restart-settings-note').text('Saved — reload any page to see the topbar icon ' + (show ? 'appear' : 'disappear') + '.');
  });
});
</script>
