#!/bin/bash
# Runs on every array start / webGUI (re)load. Re-applies the topbar
# script injection idempotently, since this core file can be overwritten
# by an Unraid OS update and would otherwise lose the patch.
#
# NOTE: on Unraid 7.x there is no webGui/include/Header.php — the page
# shell (including the closing </body>) lives in webGui/include/DefaultPageLayout.php.
# The topbar itself (search/notifications/logout) is rendered by a web
# component (<unraid-header-os-version>, from dynamix.my.servers), likely
# behind a shadow root our injected JS can't reach into — hence the JS's
# fallback floating button rather than a truly inline icon.

LAYOUT="/usr/local/emhttp/webGui/include/DefaultPageLayout.php"
MARK_START="<!-- smb-restart:start -->"
MARK_END="<!-- smb-restart:end -->"
SNIPPET="${MARK_START}\n<script src=\"/plugins/smb-restart/javascript/smb-restart.js\"></script>\n${MARK_END}"

[[ -f "$LAYOUT" ]] || exit 0

# Remove any previous injection (in case the file changed) then re-insert.
sed -i "/${MARK_START}/,/${MARK_END}/d" "$LAYOUT"

if grep -q '</body>' "$LAYOUT"; then
    sed -i "s#</body>#${SNIPPET}\n</body>#" "$LAYOUT"
fi
